<Module>
	<Name value="Custom Bannerlord Scene Creator"/>
	<Id value="CustomSceneCreator"/>
	<!-- Version 1.0.5 is the development line following the public 1.0.4 release. -->
	<Version value="v1.0.7"/>
	<SingleplayerModule value="true"/>
	<MultiplayerModule value="false"/>
	<DependedModules>
		<DependedModule Id="Bannerlord.Harmony"/>
		<DependedModule Id="Native"/>
		<DependedModule Id="SandBoxCore"/>
		<DependedModule Id="Sandbox"/>
		<DependedModule Id="StoryMode"/>
	</DependedModules>
	<DependedModuleMetadatas>
		<!-- Required for the movement-only controller used while editing. -->
		<DependedModuleMetadata id="Bannerlord.Harmony" order="LoadBeforeThis" />
		<!-- MCM is optional: it provides the key-rebinding screen. Without it the editor runs on its
		     default bindings, so it must load first if present and be absent without complaint. -->
		<DependedModuleMetadata id="Bannerlord.MBOptionScreen" order="LoadBeforeThis" optional="true" />
		<DependedModuleMetadata id="Native" order="LoadBeforeThis" />
		<DependedModuleMetadata id="SandBoxCore" order="LoadBeforeThis" />
		<DependedModuleMetadata id="Sandbox" order="LoadBeforeThis" />
		<DependedModuleMetadata id="StoryMode" order="LoadBeforeThis" />
	</DependedModuleMetadatas>
	<SubModules>
		<SubModule>
			<Name value="Custom Bannerlord Scene Creator"/>
			<DLLName value="CustomSceneCreator.dll"/>
			<SubModuleClassType value="CustomSceneCreator.SubModule"/>
			<Tags>
				<Tag key="DedicatedServerType" value="none"/>
				<Tag key="IsNoRenderModeElement" value="false"/>
			</Tags>
		</SubModule>
	</SubModules>
</Module>
