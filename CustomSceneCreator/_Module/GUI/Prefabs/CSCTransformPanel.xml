<Prefab>
  <Window>
    <!-- This full-screen root must be click-through. The passive layer hit-tests native widgets,
         so only the compact panel and its controls may accept events. -->
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" DoNotAcceptEvents="true">
      <Children>
        <!-- Compact fields leave room for exact XYZ positioning without making the panel obscure
             the scene. The button always remains inside this hit-test rectangle. -->
        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="420" SuggestedHeight="500" HorizontalAlignment="Right" VerticalAlignment="Center" MarginRight="28">
          <Children>
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="StdAssets\Popup\canvas" IsEnabled="false" />
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="frame_9" ExtendLeft="18" ExtendTop="18" ExtendRight="18" ExtendBottom="18" IsEnabled="false" />
            <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" StackLayout.LayoutMethod="VerticalTopToBottom" MarginLeft="24" MarginRight="24" MarginTop="18" MarginBottom="18">
              <Children>
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="30" Text="@TitleText" Brush="Popup.Title.Text" HorizontalAlignment="Center" DoNotAcceptEvents="true" />
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="22" Text="@SubjectText" Brush="Popup.Description.Text" HorizontalAlignment="Center" DoNotAcceptEvents="true" />
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="38" Text="@HintText" Brush="Popup.Description.Text" HorizontalAlignment="Center" VerticalAlignment="Center" DoNotAcceptEvents="true" />

                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="20" Text="@PositionLabel" Brush="Popup.Button.Text" HorizontalAlignment="Center" MarginTop="4" DoNotAcceptEvents="true" />
                <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="32" StackLayout.LayoutMethod="HorizontalLeftToRight">
                  <Children>
                    <ListPanel WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="118" StackLayout.LayoutMethod="HorizontalLeftToRight" MarginRight="4"><Children><TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="20" Text="@XLabel" Brush="Popup.Description.Text" HorizontalAlignment="Center" VerticalAlignment="Center" DoNotAcceptEvents="true" /><Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="BlankWhiteSquare_9" Color="#111111FF" DoNotAcceptEvents="true"><Children><EditableTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" RealText="@PositionX" Brush="Review.NameInput.Text" DoNotAcceptEvents="false" HorizontalAlignment="Center" /></Children></Widget></Children></ListPanel>
                    <ListPanel WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="118" StackLayout.LayoutMethod="HorizontalLeftToRight" MarginRight="4"><Children><TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="20" Text="@YLabel" Brush="Popup.Description.Text" HorizontalAlignment="Center" VerticalAlignment="Center" DoNotAcceptEvents="true" /><Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="BlankWhiteSquare_9" Color="#111111FF" DoNotAcceptEvents="true"><Children><EditableTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" RealText="@PositionY" Brush="Review.NameInput.Text" DoNotAcceptEvents="false" HorizontalAlignment="Center" /></Children></Widget></Children></ListPanel>
                    <ListPanel WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="118" StackLayout.LayoutMethod="HorizontalLeftToRight"><Children><TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="20" Text="@ZLabel" Brush="Popup.Description.Text" HorizontalAlignment="Center" VerticalAlignment="Center" DoNotAcceptEvents="true" /><Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="BlankWhiteSquare_9" Color="#111111FF" DoNotAcceptEvents="true"><Children><EditableTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" RealText="@PositionZ" Brush="Review.NameInput.Text" DoNotAcceptEvents="false" HorizontalAlignment="Center" /></Children></Widget></Children></ListPanel>
                  </Children>
                </ListPanel>

                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="20" Text="@PitchLabel" Brush="Popup.Button.Text" Brush.FontColor="#FF5050FF" HorizontalAlignment="Center" MarginTop="5" DoNotAcceptEvents="true" />
                <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="32" StackLayout.LayoutMethod="HorizontalLeftToRight">
                  <Children>
                    <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="48" Command.Click="ExecutePitchMinus" Brush="Popup.Done.Button"><Children><TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Text="-" Brush="Popup.Button.Text" HorizontalAlignment="Center" VerticalAlignment="Center" DoNotAcceptEvents="true" /></Children></ButtonWidget>
                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="BlankWhiteSquare_9" Color="#111111FF" MarginLeft="6" MarginRight="6" DoNotAcceptEvents="true"><Children><EditableTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" RealText="@PitchText" Brush="Review.NameInput.Text" DoNotAcceptEvents="false" HorizontalAlignment="Center" /></Children></Widget>
                    <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="48" Command.Click="ExecutePitchPlus" Brush="Popup.Done.Button"><Children><TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Text="+" Brush="Popup.Button.Text" HorizontalAlignment="Center" VerticalAlignment="Center" DoNotAcceptEvents="true" /></Children></ButtonWidget>
                  </Children>
                </ListPanel>

                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="20" Text="@RollLabel" Brush="Popup.Button.Text" Brush.FontColor="#50FF70FF" HorizontalAlignment="Center" MarginTop="5" DoNotAcceptEvents="true" />
                <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="32" StackLayout.LayoutMethod="HorizontalLeftToRight">
                  <Children>
                    <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="48" Command.Click="ExecuteRollMinus" Brush="Popup.Done.Button"><Children><TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Text="-" Brush="Popup.Button.Text" HorizontalAlignment="Center" VerticalAlignment="Center" DoNotAcceptEvents="true" /></Children></ButtonWidget>
                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="BlankWhiteSquare_9" Color="#111111FF" MarginLeft="6" MarginRight="6" DoNotAcceptEvents="true"><Children><EditableTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" RealText="@RollText" Brush="Review.NameInput.Text" DoNotAcceptEvents="false" HorizontalAlignment="Center" /></Children></Widget>
                    <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="48" Command.Click="ExecuteRollPlus" Brush="Popup.Done.Button"><Children><TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Text="+" Brush="Popup.Button.Text" HorizontalAlignment="Center" VerticalAlignment="Center" DoNotAcceptEvents="true" /></Children></ButtonWidget>
                  </Children>
                </ListPanel>

                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="20" Text="@YawLabel" Brush="Popup.Button.Text" Brush.FontColor="#5090FFFF" HorizontalAlignment="Center" MarginTop="5" DoNotAcceptEvents="true" />
                <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="32" StackLayout.LayoutMethod="HorizontalLeftToRight">
                  <Children>
                    <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="48" Command.Click="ExecuteYawMinus" Brush="Popup.Done.Button"><Children><TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Text="-" Brush="Popup.Button.Text" HorizontalAlignment="Center" VerticalAlignment="Center" DoNotAcceptEvents="true" /></Children></ButtonWidget>
                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="BlankWhiteSquare_9" Color="#111111FF" MarginLeft="6" MarginRight="6" DoNotAcceptEvents="true"><Children><EditableTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" RealText="@YawText" Brush="Review.NameInput.Text" DoNotAcceptEvents="false" HorizontalAlignment="Center" /></Children></Widget>
                    <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="48" Command.Click="ExecuteYawPlus" Brush="Popup.Done.Button"><Children><TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Text="+" Brush="Popup.Button.Text" HorizontalAlignment="Center" VerticalAlignment="Center" DoNotAcceptEvents="true" /></Children></ButtonWidget>
                  </Children>
                </ListPanel>

                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="20" Text="@StepLabel" Brush="Popup.Button.Text" HorizontalAlignment="Center" MarginTop="7" DoNotAcceptEvents="true" />
                <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="110" SuggestedHeight="30" Sprite="BlankWhiteSquare_9" Color="#111111FF" HorizontalAlignment="Center" DoNotAcceptEvents="true"><Children><EditableTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" RealText="@StepText" Brush="Review.NameInput.Text" DoNotAcceptEvents="false" HorizontalAlignment="Center" /></Children></Widget>
                <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="138" SuggestedHeight="36" HorizontalAlignment="Center" MarginTop="10" Command.Click="ExecuteClose" Brush="Popup.Cancel.Button"><Children><TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Text="@CloseText" Brush="Popup.Button.Text" HorizontalAlignment="Center" VerticalAlignment="Center" DoNotAcceptEvents="true" /></Children></ButtonWidget>
              </Children>
            </ListPanel>
          </Children>
        </Widget>
      </Children>
    </Widget>
  </Window>
</Prefab>
