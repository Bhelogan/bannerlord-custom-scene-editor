# Build output
bin/
obj/
.vs/
.build/
DistBuildTemp/
Dist/
Release/
crash reports/

# User-specific
*.user
*.suo
*.userosscache
*.sln.docstates

# NuGet
packages/
*.nupkg

# Compiled temp/test executables
*.exe

# Derived scenes (§8): these copy multi-megabyte Native terrain.bin / navmesh.bin
# binaries out of the player's own game install. They are generated locally by
# tools/derive_scene.ps1 and must never be committed or redistributed.
CustomSceneCreator/_Module/SceneObj/csc_*/
**/SceneObj/csc_*/

# Generated catalogs — regenerated by tools/*.ps1 against the local game install.
# The committed copies live in _Module/ModuleData; these are scratch outputs.
tools/out/
tools/__pycache__/

# Locally generated engine-load candidates. Keep their small README/test protocol, not game-derived
# binary payloads.
TestArtifacts/**/*.bin

# Local tooling archive, not part of the mod.
tools.zip

# Locally baked navmesh candidates. These are derived from the player's own installed
# battle terrains - TaleWorlds' data, not ours to redistribute - and are regenerated by
# tools/NavMeshPortTests at will. 42 MB of them accumulated during the elevation work.
artifacts/

# A malformed command line once created a file literally named "--debug-disconnected",
# which is a 1.5 MB navmesh blob. Ignored rather than deleted, in case it is still wanted.
--debug-disconnected

# Same command-line mistake during elevated-route testing; this is a generated NMG9 blob.
tools/NavMeshPortTests/--ramp-label
